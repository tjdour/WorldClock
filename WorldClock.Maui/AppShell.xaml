<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WorldClock.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WorldClock.Maui"
    Title="WorldClock.Maui">

    <TabBar>

        <ShellContent
        Title="Clocks"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

        <ShellContent
        Title="Compare"
        ContentTemplate="{DataTemplate local:ComparePage}"
        Route="ComparePage" />

    </TabBar>

</Shell>
