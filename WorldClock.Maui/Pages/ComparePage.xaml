<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WorldClock.Maui.ComparePage"
    Title="Compare">

    <Grid Padding="30">

        <VerticalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="850"
            Spacing="25">

            <Label
                Text="Time Zone Converter"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="50">

                <!-- FROM -->
                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="12">

                    <Label
                        Text="FROM"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <Picker
                        x:Name="SourceLocationPicker"
                        Title="Choose city" />

                    <DatePicker
                        x:Name="SourceDatePicker" />

                    <TimePicker
                        x:Name="SourceTimePicker"
                        Format="h:mm tt" />

                </VerticalStackLayout>

                <!-- TO -->
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="12">

                    <Label
                        Text="TO"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <Picker
                        x:Name="DestinationLocationPicker"
                        Title="Choose city" />

                    <Label
                        x:Name="DestinationTimeLabel"
                        Text="--:--"
                        FontSize="30"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <Label
                        x:Name="DestinationDateLabel"
                        Text="Select a date and time"
                        FontSize="18"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </Grid>

            <HorizontalStackLayout
    HorizontalOptions="Center"
    Spacing="15">

                <Button
        Text="Now"
        Clicked="OnNowClicked"
        WidthRequest="120" />

                <Button
        Text="⇄"
        Clicked="OnSwapClicked"
        WidthRequest="80" />

                <Button
        Text="Convert"
        Clicked="OnConvertClicked"
        WidthRequest="160" />

            </HorizontalStackLayout>

            <Label
                x:Name="DifferenceResultLabel"
                FontSize="20"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>